NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used by sitemap.ts and robots.ts to build absolute URLs. Set this to your
# deployed origin (e.g. your *.vercel.app URL, or a custom domain later).
# Falls back to http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=

# Server-only — never exposed to the browser. Used by /admin to read,
# edit, and delete data, bypassing Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# Google sign-in is configured entirely in the Supabase dashboard
# (Authentication > Providers > Google) — no client ID/secret needed here.
# The first admin must be promoted manually: after signing in once, find
# your row in Supabase Table Editor > profiles and set role = 'admin'.

# Server-only — powers the skincare assistant chat widget (/api/chat).
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
