NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used by sitemap.ts and robots.ts to build absolute URLs. Set this to your
# deployed origin (e.g. your *.vercel.app URL, or a custom domain later).
# Falls back to http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=

# Server-only — never exposed to the browser. Used by /admin to read,
# edit, and delete data, bypassing Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# Google sign-in is configured entirely in the Supabase dashboard
# (Authentication > Providers > Google) — no client ID/secret needed here.
# The first admin must be promoted manually: after signing in once, find
# your row in Supabase Table Editor > profiles and set role = 'admin'.

# Server-only — powers the skincare assistant chat widget (/api/chat).
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Server-only — powers the £1 PDF guide checkout (/api/checkout, /api/download)
# and the Pro subscription checkout (/api/checkout/pro, /api/billing-portal).
# Get this from https://dashboard.stripe.com/test/apikeys (starts with sk_test_
# while testing, sk_live_ once you switch the dashboard to live mode).
STRIPE_SECRET_KEY=

# Server-only — verifies that /api/webhooks/stripe requests really came from
# Stripe. This is what keeps profiles.plan in sync with the Pro subscription.
# For local dev, install the Stripe CLI and run:
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
# then copy the "whsec_..." secret it prints. In production, create a webhook
# endpoint at https://dashboard.stripe.com/test/webhooks pointing at
# <your-site>/api/webhooks/stripe, listening for checkout.session.completed,
# customer.subscription.updated, and customer.subscription.deleted, and copy
# its signing secret instead.
STRIPE_WEBHOOK_SECRET=
