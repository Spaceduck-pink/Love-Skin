NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never exposed to the browser. Used by /admin to read,
# edit, and delete data, bypassing Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# Password for the /admin dashboard login.
ADMIN_PASSWORD=

# Random secret used to sign the admin session cookie.
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=
